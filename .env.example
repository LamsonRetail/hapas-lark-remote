LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_DOMAIN=lark
PORT=8787

# tailscale  = Tailscale Funnel, URL cố định, miễn phí, không cần domain
# cloudflare = cloudflared; thêm TUNNEL_NAME để có URL cố định (cần domain),
#              bỏ trống TUNNEL_NAME thì URL đổi mỗi lần chạy lại
TUNNEL=tailscale
# TUNNEL_NAME=

# Supervisor tự ghi đè khi dựng tunnel — không cần điền tay
PUBLIC_URL=http://localhost:8787
TOKEN_ENC_KEY=
# Full scope cua app, cach nhau bang dau cach. `offline_access` la BAT BUOC
# (thieu la khong co refresh token). Lark thuc te cap tron quyen app bat ke
# tham so nay, nhung khai du thi trang dong y hien dung nhung gi se duoc dung.
# Danh sach dang cap nam o truong `scope` cua token trong .data/tokens.json.
LARK_SCOPES=offline_access
# Canary: mỗi N phút tự gọi vài tool chỉ-đọc để phát hiện Lark đổi API trước khi
# có người dùng đâm vào. 0 = tắt. CANARY_OPEN_ID phải là user ĐÃ đăng nhập.
CANARY_EVERY_MIN=60
CANARY_OPEN_ID=
CANARY_ALERT_OPEN_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
