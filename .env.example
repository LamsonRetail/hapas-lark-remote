LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_DOMAIN=lark
PORT=8787

# tailscale  = Tailscale Funnel, URL cố định, miễn phí, không cần domain
# cloudflare = cloudflared; thêm TUNNEL_NAME để có URL cố định (cần domain),
#              bỏ trống TUNNEL_NAME thì URL đổi mỗi lần chạy lại
TUNNEL=tailscale
# TUNNEL_NAME=

# Supervisor tự ghi đè khi dựng tunnel — không cần điền tay
PUBLIC_URL=http://localhost:8787
TOKEN_ENC_KEY=
# Full scope cua app, cach nhau bang dau cach. `offline_access` la BAT BUOC
# (thieu la khong co refresh token). Lark thuc te cap tron quyen app bat ke
# tham so nay, nhung khai du thi trang dong y hien dung nhung gi se duoc dung.
# Danh sach dang cap nam o truong `scope` cua token trong .data/tokens.json.
# Xin scope ma app KHONG co thi Lark khong bao loi, no am tham cap it hon: da do
# 180 scope va nhan ve 175 (thieu docs:event:subscribe, docs:permission.member:
# retrieve, drive:file.meta.sec_label.read_only, search:bot, wiki:wiki). Nen doi
# chieu bang `scope` cua token sau khi dang nhap, dung tin danh sach da xin.
LARK_SCOPES=offline_access
# Canary: cứ N phút tự gọi vài tool để phát hiện Lark đổi API trước khi có người
# dùng đâm vào. 0 = tắt. CANARY_OPEN_ID phải là user ĐÃ đăng nhập.
# Mỗi lượt cộng nhiễu ±25% nên các lượt không rơi đúng cùng mốc đồng hồ mỗi ngày.
#   144 = ~10 lượt/ngày (đang dùng)   60 = ~24 lượt/ngày
CANARY_EVERY_MIN=144
# Canary co goi ca nhom tool GHI khong (1 = co, mac dinh). Probe ghi tu don sach
# sau moi luot va dung lai mot khu nhap co dinh, khong sinh file moi moi gio.
# Dat 0 neu khong muon server tu ghi gi vao Drive cua CANARY_OPEN_ID.
CANARY_WRITE=1
CANARY_OPEN_ID=
CANARY_ALERT_OPEN_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
